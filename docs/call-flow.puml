@startuml call-flow
title torrust-mudlark - Execution / Call Flow

skinparam backgroundColor #FFFFFF
skinparam sequence {
    ParticipantBackgroundColor #DDEEFF
    ParticipantBorderColor #336699
    ArrowColor #555555
    LifeLineBorderColor #AAAAAA
    BoxBackgroundColor #F0F0F0
    BoxBorderColor #CCCCCC
}
skinparam note {
    BackgroundColor #FFFDE7
    BorderColor #FFD700
}

actor "User code" as User

box "Public API / Trait Adapters" #EEF4FF
    participant "graph/traits" as api
end box

box "Core State" #F4F8FF
    participant "graph/gv_graph" as core
end box

box "Algorithms" #FFF5EE
    participant "observe" as obs
    participant "split" as spl
    participant "rebalance" as reb
    participant "budget" as bud
    participant "evict" as evi
    participant "query" as qry
    participant "sample" as smp
    participant "decay" as dec
    participant "plateau tracker" as plt
end box

box "Tree Utilities" #EEFEE8
    participant "gtree" as gtree
    participant "vtree" as vtree
end box

note over plt
DynamicPlateauTracker is active when the
dynamic-contour-tracking feature is enabled.
Otherwise the NoopPlateauTracker methods are no-ops.
end note

' observe path
User -> api : observe(coord, delta)
activate api
api -> core : SpatialWrite::observe
activate core
core -> obs : observe(coord, delta)
activate obs

obs -> gtree : phase 1: route_to(coord)
activate gtree
gtree --> obs : receiving G-node
deactivate gtree

obs -> vtree : phase 2: sync entry intensity\npropagate sums\nenqueue violated ancestors
activate vtree
vtree --> obs
deactivate vtree

obs -> gtree : phase 3: recompute_sums(g_id)
activate gtree
gtree --> obs
deactivate gtree

obs -> plt : phase 4: plateau_after_observe
activate plt
plt --> obs
deactivate plt

obs -> spl : phase 5a: attempt_split(g_id)
activate spl
spl -> reb : phase 5b: resolve queued 2-3 violations
activate reb
reb --> spl : new legacy-promote G-nodes?
deactivate reb
spl --> obs
deactivate spl

obs -> bud : phase 6: adjust_depth_gates()
activate bud
bud --> obs
deactivate bud

obs -> evi : phase 7: check_evictions()\nor check_evictions_bounded()
activate evi
evi -> reb : rebalance after batched evictions
activate reb
reb --> evi
deactivate reb
evi --> obs
deactivate evi

obs -> plt : phase 8: normalize_plateaus()\nthen repair_p_i4()
activate plt
plt --> obs
deactivate plt

obs --> core
deactivate obs
core --> api
deactivate core
api --> User
deactivate api

' get path
User -> api : get(coord)
activate api
api -> core : SpatialRead::get
activate core
core -> qry : get(coord)
activate qry
qry -> gtree : clamp coord\nroute_to(coord)
activate gtree
gtree --> qry : terminal or semi-internal G-node
deactivate gtree
qry --> core : Cell { start, end, intensity, depth }
deactivate qry
core --> api
deactivate core
api --> User
deactivate api

' sample path
User -> api : sample(rng)
activate api
api -> core : WeightedSampler::sample
activate core
core -> smp : sample(rng)
activate smp
smp -> vtree : descend by child intensities
activate vtree
vtree --> smp : Entry V-node -> backing G-node
deactivate vtree
smp --> core : Cell
deactivate smp
core --> api
deactivate core
api --> User
deactivate api

' decay path
User -> api : decay(root, attenuation, q)
activate api
api -> core : TemporalDecay::decay
activate core
core -> dec : decay(root, attenuation, q)
activate dec
dec -> gtree : attenuate own values\nrecompute G sums
activate gtree
gtree --> dec
deactivate gtree
dec -> vtree : recompute V intensities
activate vtree
vtree --> dec
deactivate vtree
dec -> reb : resolve violations created by decay
activate reb
reb --> dec
deactivate reb
dec -> plt : post-decay repair\nnormalize + P-I4 maintenance
activate plt
plt --> dec
deactivate plt
dec --> core
deactivate dec
core --> api
deactivate core
api --> User
deactivate api

@enduml
