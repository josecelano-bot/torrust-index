@startuml component-architecture
title torrust-mudlark - Module Architecture (Component View)

skinparam componentStyle rectangle
skinparam packageStyle rectangle
skinparam backgroundColor #FFFFFF
skinparam component {
    BackgroundColor #DDEEFF
    BorderColor #336699
    FontSize 11
}
skinparam package {
    BackgroundColor #F5F5F5
    BorderColor #999999
    FontSize 12
    FontStyle bold
}
skinparam arrow {
    Color #555555
    FontSize 10
}
skinparam linetype ortho

package "1. Foundation" {
    [arena\nArena<T>\nfree-list storage] as arena
    [handle\nGNodeId · VNodeId] as handle
    [traits\nCoordinate · Accumulator\nObservation · Rng\nSpatialRead/Write\nTemporalDecay · WeightedSampler] as traits
}

package "2. Node Types (nodes/)" {
    [nodes/gnode\nGNode · GState\nTerminal / SemiInternal / Internal] as gnode
    [tree/vtree/vnode\nVNode · VKind\nChildren::Pair / Triple] as vnode
}

package "3. Spatial Types (spatial/)" {
    [spatial/view\nSpan · Cell] as view
    [spatial/node\nNode projection] as node
    [spatial/plateau\nPlateau · BasisEdge] as plateau
    [spatial/contour_range\nContourRange · BasisElement] as contour_range
    [spatial/plateau_basis\nPlateauBasis\nfeature-gated index] as plateau_basis
    [spatial/pewei\nPewei · Layer\nTransition · Terminal] as pewei
}

package "4. Tree Utilities (tree/)" {
    [tree/gtree\nrouting · depth helpers\nG sum propagation] as gtree
    [tree/vtree\nintensity propagation\nviolations queue\nevictable maintenance] as vtree
}

package "5. Core Graph State (graph/)" {
    [graph/config\nConfig · StructuralConfig] as graph_config
    [graph/gv_graph\nGvGraph · DefaultGraph\nDefaultTracker strategy] as graph_core
    [graph/mod\nnamespace + re-exports] as graph_mod
}

package "6. Algorithms (graph/algorithm/)" {
    [observe\n8-phase mutation pipeline] as observe
    [split/\nbootstrap + catalytic split] as split
    [rebalance/\nviolation scan\nresolve + contract] as rebalance
    [promote\nstandard · skip · legacy\nonly legacy mutates G-tree] as promote
    [budget\ndepth-gate tuning\nlegacy-promote accounting] as graph_budget
    [evict\ntip eviction\nbounded / unbounded batch] as evict
    [decay\nuniform + selective decay] as decay
    [query/\nget · range_sum · contour_range · sample] as graph_query
    [extract\nextract / reconstruct to Pewei] as graph_extract
    [plateau/\nPlateauTracking facade\nNoop + Dynamic tracker] as graph_plateau
    [dynamic_tracker\nincremental plateau mirror\nfeature-gated] as dynamic_tracker
}

package "7. Public Trait Adapters" {
    [graph/traits\nimpl SpatialRead / SpatialWrite\nTemporalDecay / WeightedSampler\nPlateauRead when enabled] as graph_traits
}

package "8. Diagnostics (diagnostics/)" {
    [diagnostics/invariants\ncheck_all_invariants\nG-I · V-I · D-I · P-I] as invariants
    [diagnostics/diagnostic\nviolation audits\nmissed-violation diagnosis] as diagnostic
    [diagnostics/display + dot + dump\nrendering / export helpers] as diag_render
}

note right of dynamic_tracker
Enabled by the dynamic-contour-tracking feature.
NoopPlateauTracker is used when disabled.
end note

handle --> gnode
handle --> vnode
traits --> graph_traits

gnode --> gtree
gnode --> node
gnode --> plateau
vnode --> vtree

view --> node
view --> plateau
view --> pewei
plateau --> contour_range
plateau_basis --> dynamic_tracker

arena --> gtree
arena --> vtree
gtree --> graph_core
vtree --> graph_core
graph_config --> graph_core
graph_core --> graph_mod

graph_core --> observe
graph_core --> decay
graph_core --> graph_query
graph_core --> graph_extract
graph_core --> graph_plateau

observe --> split
observe --> rebalance
observe --> graph_budget
observe --> evict
observe --> graph_plateau

split --> rebalance
rebalance --> promote
graph_budget --> evict
evict --> rebalance
decay --> rebalance
decay --> graph_plateau

gtree --> split
gtree --> rebalance
gtree --> graph_query
gtree --> graph_plateau
vtree --> rebalance
vtree --> graph_query
plateau --> graph_plateau
dynamic_tracker --> graph_plateau
pewei --> graph_extract

graph_core --> graph_traits
graph_core --> invariants
graph_core --> diagnostic
graph_core --> diag_render
rebalance --> diagnostic
rebalance --> invariants
graph_plateau --> invariants

@enduml
