@startuml component-architecture
title torrust-mudlark — Module Architecture (Component View)

skinparam componentStyle rectangle
skinparam packageStyle rectangle
skinparam backgroundColor #FFFFFF
skinparam component {
    BackgroundColor #DDEEFF
    BorderColor #336699
    FontSize 11
}
skinparam package {
    BackgroundColor #F5F5F5
    BorderColor #999999
    FontSize 12
    FontStyle bold
}
skinparam arrow {
    Color #555555
    FontSize 10
}
skinparam linetype ortho

' ─────────────────────────────────────────
' ① Foundation — no internal dependencies
' ─────────────────────────────────────────
package "① Foundation" {
    [arena\n<size:9>Memory pool (free-list)</size>] as arena
    [handle\n<size:9>GNodeId · VNodeId</size>] as handle
    [traits/\n<size:9>Coordinate · Accumulator\nSpatialRead/Write + 11 more</size>] as traits
}

' ─────────────────────────────────────────
' ② Node Types
' ─────────────────────────────────────────
package "② Node Types  (nodes/)" {
    [nodes/gnode\n<size:9>GNode · GState\n(Terminal/SemiInternal/Internal)</size>] as gnode
    [nodes/vnode\n<size:9>VNode · VKind\n(Entry / Structural)</size>] as vnode
}

' ─────────────────────────────────────────
' ③ Spatial / Output Types
' ─────────────────────────────────────────
package "③ Spatial / Output Types  (spatial/)" {
    [spatial/view\n<size:9>Span · Cell</size>] as view
    [spatial/node\n<size:9>Node (query-facing\nGNode projection)</size>] as node
    [spatial/plateau\n<size:9>Plateau · BasisEdge</size>] as plateau
    [spatial/plateau_basis\n<size:9>PlateauBasis\n(dynamic tracker index)</size>] as plateau_basis
    [spatial/pewei\n<size:9>Pewei · Layer\nTransition · Terminal</size>] as pewei
    [spatial/contour_range\n<size:9>ContourRange · BasisElement</size>] as contour_range
}

' ─────────────────────────────────────────
' ④ Tree Utilities
' ─────────────────────────────────────────
package "④ Tree Utilities  (tree/)" {
    [tree/gtree\n<size:9>G-tree routing\ndepth · sum propagation</size>] as gtree
    [tree/vtree\n<size:9>V-tree propagation\nevictable-flag maintenance</size>] as vtree
}

' ─────────────────────────────────────────
' ⑤ Core Data Structure
' ─────────────────────────────────────────
package "⑤ Core Data Structure  (graph/)" {
    [graph/mod\n<size:9>thin namespace\nre-exports only</size>] as graph
    [graph/config\n<size:9>Config · StructuralConfig\nvalidate()</size>] as graph_config
    [graph/gv_graph\n<size:9>GvGraph · DefaultGraph\nstate + accessors</size>] as graph_core
}

' ─────────────────────────────────────────
' ⑥ Algorithms
' ─────────────────────────────────────────
package "⑥ Algorithms  (graph/algorithm/)" {
    [algorithm/observe\n<size:9>mutation orchestrator\nupdate→split→rebalance\n→budget→plateau</size>] as observe
    [algorithm/split\n<size:9>bootstrap split\ncatalytic split</size>] as split
    [algorithm/rebalance\n<size:9>2-3 tree violation\ndetection and repair</size>] as rebalance
    [algorithm/evict\n<size:9>tip eviction\nbounded eviction loop</size>] as evict
    [algorithm/decay\n<size:9>uniform and selective\ntemporal attenuation</size>] as decay
    [algorithm/budget\n<size:9>depth-gate tuning\nD_create / D_evict</size>] as graph_budget
    [algorithm/plateau\n<size:9>dynamic plateau\nmaintenance</size>] as graph_plateau
    [algorithm/query\n<size:9>get(coord)\nsample(rng)</size>] as graph_query
    [algorithm/extract\n<size:9>extract() to Pewei\nreconstruct()</size>] as graph_extract
}

' ─────────────────────────────────────────
' ⑦ Public API
' ─────────────────────────────────────────
package "⑦ Public API  (graph/traits.rs)" {
    [graph/traits\n<size:9>SpatialWrite · SpatialRead\nWeightedSampler · TemporalDecay\nimplemented for GvGraph</size>] as graph_traits
}

' ─────────────────────────────────────────
' ⑧ Diagnostics
' ─────────────────────────────────────────
package "⑧ Diagnostics  (diagnostics/)" {
    [diagnostics/invariants\n<size:9>check_all_invariants()\nG-I · V-I · D-I · P-I</size>] as invariants
    [diagnostics/diagnostic\n<size:9>violation detection\naudit helpers</size>] as diagnostic
}

' ─────────────────────────────────────────
' Dependencies
' ─────────────────────────────────────────

handle --> gnode
handle --> vnode

gnode --> node
gnode --> plateau
handle --> node
view --> node
view --> plateau
view --> pewei
plateau --> contour_range

arena --> gtree
arena --> vtree
gnode --> gtree
gnode --> vtree
vnode --> vtree

arena --> graph_core
gnode --> graph_core
vnode --> graph_core
plateau --> graph_core
node --> graph_core
graph_config --> graph_core
graph_core --> graph
graph_config --> graph

graph_core --> observe
graph_core --> split
graph_core --> rebalance
graph_core --> evict
graph_core --> decay
graph_core --> graph_budget
graph_core --> graph_plateau
graph_core --> graph_query
graph_core --> graph_extract

gtree --> split
gtree --> rebalance
gtree --> graph_query
vtree --> split
vtree --> rebalance
contour_range --> graph_query
plateau --> graph_query
plateau --> graph_plateau
plateau_basis --> graph_plateau
pewei --> graph_extract

rebalance ..> split : called by
split ..> observe : called by
evict ..> graph_budget : called by
graph_budget ..> observe : called by
graph_plateau ..> observe : called by

graph_core --> graph_traits
graph_core --> invariants
graph_core --> diagnostic
rebalance --> invariants
rebalance --> diagnostic
gtree --> invariants

@enduml
